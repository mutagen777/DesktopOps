@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject SecurityOptions Security
@inject IHttpContextAccessor HttpContextAccessor
@using System.Security.Claims

<div class="admin-shell">
    <nav class="admin-sidebar">
        <div class="admin-brand">
            <a href="">DesktopOps</a>
        </div>
        <NavMenu />
        <div class="admin-version">
            <div>Admin</div>
            @if (!Security.Enabled)
            {
                <div class="admin-user">@L["AuthOff"]</div>
            }
            else
            {
                <div class="admin-user">@(CurrentUser ?? "—")</div>
                <div class="admin-debug-label">@L["Config"]</div>
                <div class="admin-user">M: @Security.ADGroup</div>
                <div class="admin-user">D: @Security.DeveloperADGroup</div>
                <div class="admin-debug-label">@L["Roles"]</div>
                @if (RoleClaims.Count == 0)
                {
                    <div class="admin-user">@L["NoRoleClaims"]</div>
                }
                else
                {
                    @foreach (var role in RoleClaims)
                    {
                        <div class="admin-user admin-role" title="@role">@role</div>
                    }
                }
            }
        </div>
    </nav>

    <div class="admin-main">
        <header class="admin-header">
            <span class="admin-page-title">@CurrentTitle</span>
        </header>
        <main class="admin-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet style="display: none">
    @L["UnexpectedError"]
    <a href="." class="reload">@L["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? CurrentUser =>
        HttpContextAccessor.HttpContext?.User?.Identity?.Name;

    private IReadOnlyList<string> RoleClaims
    {
        get
        {
            var user = HttpContextAccessor.HttpContext?.User;
            if (user?.Identity?.IsAuthenticated != true)
            {
                return [];
            }

            return user.FindAll(ClaimTypes.Role)
                .Select(static claim => claim.Value)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(static value => value, StringComparer.OrdinalIgnoreCase)
                .Take(12)
                .ToList();
        }
    }

    private string CurrentTitle
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();
            if (string.IsNullOrEmpty(relative))
            {
                return L["Nav_Overview"];
            }

            if (relative.StartsWith("programs"))
            {
                return L["Nav_Programs"];
            }

            if (relative.StartsWith("groups"))
            {
                return L["Nav_Groups"];
            }

            if (relative.StartsWith("assignments"))
            {
                return L["Nav_Assignments"];
            }

            if (relative.StartsWith("releases"))
            {
                return L["Nav_Releases"];
            }

            if (relative.StartsWith("rollouts"))
            {
                return L["Nav_Rollouts"];
            }

            if (relative.StartsWith("license"))
            {
                return L["Nav_License"];
            }

            return "DesktopOps";
        }
    }
}
