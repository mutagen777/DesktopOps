@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject SecurityOptions Security
@inject IHttpContextAccessor HttpContextAccessor
@using System.Security.Claims

<div class="admin-shell">
    <nav class="admin-sidebar">
        <div class="admin-brand">
            <a href="">DesktopOps</a>
        </div>
        <NavMenu />
        <div class="admin-version">
            <div>Admin</div>
            @if (!Security.Enabled)
            {
                <div class="admin-user">Auth aus</div>
            }
            else
            {
                <div class="admin-user">@(CurrentUser ?? "nicht angemeldet")</div>
                <div class="admin-debug-label">Konfig</div>
                <div class="admin-user">M: @Security.ADGroup</div>
                <div class="admin-user">D: @Security.DeveloperADGroup</div>
                <div class="admin-debug-label">Rollen</div>
                @if (RoleClaims.Count == 0)
                {
                    <div class="admin-user">keine Role-Claims</div>
                }
                else
                {
                    @foreach (var role in RoleClaims)
                    {
                        <div class="admin-user admin-role" title="@role">@role</div>
                    }
                }
            }
        </div>
    </nav>

    <div class="admin-main">
        <header class="admin-header">
            <span class="admin-page-title">@CurrentTitle</span>
        </header>
        <main class="admin-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? CurrentUser =>
        HttpContextAccessor.HttpContext?.User?.Identity?.Name;

    private IReadOnlyList<string> RoleClaims
    {
        get
        {
            var user = HttpContextAccessor.HttpContext?.User;
            if (user?.Identity?.IsAuthenticated != true)
            {
                return [];
            }

            return user.FindAll(ClaimTypes.Role)
                .Select(static claim => claim.Value)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(static value => value, StringComparer.OrdinalIgnoreCase)
                .Take(12)
                .ToList();
        }
    }

    private string CurrentTitle
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();
            if (string.IsNullOrEmpty(relative))
            {
                return "Übersicht";
            }

            if (relative.StartsWith("programs"))
            {
                return "Programme";
            }

            if (relative.StartsWith("groups"))
            {
                return "Gruppen";
            }

            if (relative.StartsWith("assignments"))
            {
                return "Zuweisungen";
            }

            if (relative.StartsWith("releases"))
            {
                return "Releases";
            }

            if (relative.StartsWith("rollouts"))
            {
                return "Rollouts";
            }

            return "DesktopOps";
        }
    }
}
