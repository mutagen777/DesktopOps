@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="admin-shell">
    <nav class="admin-sidebar">
        <div class="admin-brand">
            <a href="">DesktopOps</a>
        </div>
        <NavMenu />
        <div class="admin-version">Admin</div>
    </nav>

    <div class="admin-main">
        <header class="admin-header">
            <span class="admin-page-title">@CurrentTitle</span>
        </header>
        <main class="admin-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string CurrentTitle
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();
            if (string.IsNullOrEmpty(relative))
            {
                return "Übersicht";
            }

            if (relative.StartsWith("programs"))
            {
                return "Programme";
            }

            if (relative.StartsWith("groups"))
            {
                return "Gruppen";
            }

            if (relative.StartsWith("assignments"))
            {
                return "Zuweisungen";
            }

            if (relative.StartsWith("releases"))
            {
                return "Releases";
            }

            if (relative.StartsWith("rollouts"))
            {
                return "Rollouts";
            }

            return "DesktopOps";
        }
    }
}
