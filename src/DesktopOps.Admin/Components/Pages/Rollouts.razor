@page "/rollouts"
@attribute [Authorize(Policy = "Manager")]
@rendermode InteractiveServer
@inject IDbContextFactory<DesktopOpsDbContext> DbFactory

<PageTitle>@L["Nav_Rollouts"]</PageTitle>

<p class="page-lead">@L["Lead_Rollouts"]</p>

<div class="table-panel">
    <table class="table">
        <thead>
            <tr>
                <th>@L["TimeUtc"]</th>
                <th>@L["User"]</th>
                <th>@L["Machine"]</th>
                <th>@L["Program"]</th>
                <th>@L["Version"]</th>
                <th>@L["Status"]</th>
                <th>@L["Message"]</th>
            </tr>
        </thead>
        <tbody>
            @if (events.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-muted">@L["NoRolloutEvents"]</td>
                </tr>
            }
            else
            {
                @foreach (var item in events)
                {
                    <tr>
                        <td>@item.TimestampUtc.ToString("u")</td>
                        <td>@item.ClientRegistration?.UserName</td>
                        <td>@item.ClientRegistration?.MachineName</td>
                        <td>@item.ReleasePackage?.Program?.Name</td>
                        <td>@item.ReleasePackage?.Version</td>
                        <td>@item.Status</td>
                        <td>@item.Message</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private List<DeploymentEvent> events = [];

    protected override async Task OnInitializedAsync()
    {
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var loaded = await dbContext.DeploymentEvents
            .Include(static item => item.ClientRegistration)
            .Include(static item => item.ReleasePackage!)
                .ThenInclude(static item => item.Program)
            .ToListAsync();
        events = loaded
            .OrderByDescending(static item => item.TimestampUtc)
            .Take(200)
            .ToList();
    }
}
