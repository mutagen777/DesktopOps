@page "/groups"
@attribute [Authorize(Policy = "Manager")]
@rendermode InteractiveServer
@inject IDbContextFactory<DesktopOpsDbContext> DbFactory
@inject IDirectoryAccountLookup DirectoryLookup
@inject DirectoryGroupSyncService DirectorySync

<PageTitle>@L["Nav_Groups"]</PageTitle>

<p class="page-lead">@L["Lead_Groups"]</p>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="panel status-banner">@statusMessage</div>
}

<div class="panel">
    <div class="panel-title">@L["CreateGroup"]</div>
    <EditForm Model="newGroup" OnValidSubmit="CreateGroupAsync">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">@L["Name"]</label>
                <InputText class="form-control" @bind-Value="newGroup.Name" />
            </div>
            <div class="col-md-4">
                <label class="form-label">@L["Description"]</label>
                <InputText class="form-control" @bind-Value="newGroup.Description" />
            </div>
            <div class="col-md-4">
                <label class="form-label">@L["AdGroupOptional"]</label>
                <InputText class="form-control" @bind-Value="newGroup.ActiveDirectoryGroup" placeholder="@L["PlaceholderAdGroup"]" />
            </div>
            <div class="col-md-8">
                <label class="form-label">@L["UsersCommaSeparated"]</label>
                <InputText class="form-control" @bind-Value="newGroup.UserNames" placeholder="@L["PlaceholderUsers"]" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-primary w-100" type="submit">@L["Add"]</button>
            </div>
        </div>
    </EditForm>
</div>

@if (groups.Count == 0)
{
    <p class="empty-state">@L["NoGroups"]</p>
}

@foreach (var group in groups)
{
    <div class="panel">
        <h3 style="margin:0;font-size:1.1rem;">@group.Name</h3>
        <p class="group-meta">@(string.IsNullOrWhiteSpace(group.Description) ? L["NoDescription"].Value : group.Description)</p>
        <div class="group-members">
            <strong>@L["Members", group.Members.Count]</strong>
            @if (group.Members.Count == 0)
            {
                <span> —</span>
            }
            else
            {
                <ul class="member-list">
                    @foreach (var member in group.Members.OrderBy(static item => item.UserName))
                    {
                        <li>
                            @member.UserName
                            @if (!string.IsNullOrWhiteSpace(member.WindowsSid))
                            {
                                <span class="member-sid" title="@member.WindowsSid">SID</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="row g-2 align-items-end mb-2">
            <div class="col-md-4">
                <label class="form-label">@L["AddUser"]</label>
                <input class="form-control"
                       placeholder="@L["PlaceholderUser"]"
                       value="@GetPendingMember(group.Id)"
                       @onchange="e => SetPendingMember(group.Id, e.Value?.ToString())" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="() => AddMemberAsync(group.Id)">@L["Add"]</button>
            </div>
        </div>

        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">@L["AdWindowsGroup"]</label>
                <input class="form-control"
                       placeholder="@L["PlaceholderAdUsers"]"
                       value="@GetPendingAdGroup(group.Id, group.ActiveDirectoryGroup)"
                       @onchange="e => SetPendingAdGroup(group.Id, e.Value?.ToString())" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-outline-primary w-100"
                        disabled="@(!DirectoryLookup.IsAvailable)"
                        @onclick="() => SyncFromDirectoryAsync(group.Id)">
                    @L["SyncFromAd"]
                </button>
            </div>
            <div class="col-md-3">
                <button class="btn btn-outline-secondary w-100"
                        disabled="@(!DirectoryLookup.IsAvailable)"
                        @onclick="() => ResolveMissingSidsAsync(group.Id)">
                    @L["ResolveSids"]
                </button>
            </div>
        </div>
        @if (!DirectoryLookup.IsAvailable)
        {
            <p class="group-meta mt-2 mb-0">@L["DirectoryWindowsOnly"]</p>
        }
    </div>
}

@code {
    private readonly Dictionary<Guid, string> pendingAdGroups = [];
    private readonly Dictionary<Guid, string> pendingMembers = [];
    private readonly GroupInput newGroup = new();
    private List<UserGroup> groups = [];
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task CreateGroupAsync()
    {
        statusMessage = null;
        var memberNames = newGroup.UserNames
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        var members = new List<UserGroupMember>(memberNames.Length);
        foreach (var name in memberNames)
        {
            members.Add(await CreateMemberFromNameAsync(name));
        }

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        dbContext.UserGroups.Add(new UserGroup
        {
            Name = newGroup.Name.Trim(),
            Description = newGroup.Description?.Trim(),
            ActiveDirectoryGroup = string.IsNullOrWhiteSpace(newGroup.ActiveDirectoryGroup)
                ? null
                : newGroup.ActiveDirectoryGroup.Trim(),
            Members = members
        });

        await dbContext.SaveChangesAsync();
        newGroup.Name = string.Empty;
        newGroup.Description = string.Empty;
        newGroup.ActiveDirectoryGroup = string.Empty;
        newGroup.UserNames = string.Empty;
        statusMessage = L["GroupCreated", members.Count];
        await LoadAsync();
    }

    private async Task AddMemberAsync(Guid groupId)
    {
        if (!pendingMembers.TryGetValue(groupId, out var userName) || string.IsNullOrWhiteSpace(userName))
        {
            return;
        }

        statusMessage = null;
        var member = await CreateMemberFromNameAsync(userName);
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var exists = await dbContext.UserGroupMembers.AnyAsync(item =>
            item.UserGroupId == groupId &&
            item.UserName.ToLower() == member.UserName.ToLower());
        if (!exists)
        {
            member.UserGroupId = groupId;
            dbContext.UserGroupMembers.Add(member);
            await dbContext.SaveChangesAsync();
            statusMessage = string.IsNullOrWhiteSpace(member.WindowsSid)
                ? L["UserAddedNoSid", member.UserName]
                : L["UserAdded", member.UserName];
        }

        pendingMembers[groupId] = string.Empty;
        await LoadAsync();
    }

    private async Task SyncFromDirectoryAsync(Guid groupId)
    {
        statusMessage = null;
        var adGroupName = GetPendingAdGroup(groupId, groups.FirstOrDefault(item => item.Id == groupId)?.ActiveDirectoryGroup);
        if (string.IsNullOrWhiteSpace(adGroupName))
        {
            statusMessage = L["AdGroupMissing"];
            return;
        }

        try
        {
            var result = await DirectorySync.SyncGroupAsync(groupId, adGroupName);
            if (result.Error is not null)
            {
                statusMessage = result.Error.Contains("No directory backend", StringComparison.OrdinalIgnoreCase)
                    || result.Error.Contains("Directory services", StringComparison.OrdinalIgnoreCase)
                    ? L["DirectoryUnavailable"]
                    : result.Error.Contains("not found", StringComparison.OrdinalIgnoreCase)
                        ? L["NoMembersInAd", adGroupName]
                        : result.Error;
                return;
            }

            pendingAdGroups[groupId] = result.AdGroupName;
            statusMessage = L["AdSyncResult", result.AdGroupName, result.Added, result.Updated, result.DirectoryMemberCount];
            await LoadAsync();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
        }
    }

    private async Task ResolveMissingSidsAsync(Guid groupId)
    {
        statusMessage = null;
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var members = await dbContext.UserGroupMembers
            .Where(item => item.UserGroupId == groupId)
            .ToListAsync();

        var resolved = 0;
        foreach (var member in members.Where(static item => string.IsNullOrWhiteSpace(item.WindowsSid)))
        {
            var account = await DirectoryLookup.ResolveUserAsync(member.UserName);
            if (account?.WindowsSid is null)
            {
                continue;
            }

            member.WindowsSid = account.WindowsSid;
            if (!string.Equals(member.UserName, account.UserName, StringComparison.OrdinalIgnoreCase))
            {
                member.UserName = account.UserName;
            }

            resolved++;
        }

        await dbContext.SaveChangesAsync();
        statusMessage = resolved == 0
            ? L["NoSidsResolved"]
            : L["SidsResolved", resolved];
        await LoadAsync();
    }

    private async Task<UserGroupMember> CreateMemberFromNameAsync(string userName)
    {
        var account = await DirectoryLookup.ResolveUserAsync(userName);
        return new UserGroupMember
        {
            UserName = account?.UserName ?? userName.Trim(),
            WindowsSid = account?.WindowsSid
        };
    }

    private string GetPendingMember(Guid groupId)
    {
        return pendingMembers.TryGetValue(groupId, out var value) ? value : string.Empty;
    }

    private void SetPendingMember(Guid groupId, string? value)
    {
        pendingMembers[groupId] = value ?? string.Empty;
    }

    private string GetPendingAdGroup(Guid groupId, string? stored)
    {
        if (pendingAdGroups.TryGetValue(groupId, out var value))
        {
            return value;
        }

        return stored ?? string.Empty;
    }

    private void SetPendingAdGroup(Guid groupId, string? value)
    {
        pendingAdGroups[groupId] = value ?? string.Empty;
    }

    private async Task LoadAsync()
    {
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        groups = await dbContext.UserGroups
            .Include(static item => item.Members)
            .OrderBy(static item => item.Name)
            .ToListAsync();

        foreach (var group in groups)
        {
            pendingMembers.TryAdd(group.Id, string.Empty);
            if (!string.IsNullOrWhiteSpace(group.ActiveDirectoryGroup))
            {
                pendingAdGroups.TryAdd(group.Id, group.ActiveDirectoryGroup);
            }
        }
    }

    private sealed class GroupInput
    {
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public string ActiveDirectoryGroup { get; set; } = string.Empty;

        public string UserNames { get; set; } = string.Empty;
    }
}
