@page "/assignments"
@rendermode InteractiveServer
@inject IDbContextFactory<DesktopOpsDbContext> DbFactory

<PageTitle>Zuweisungen</PageTitle>

<p class="page-lead">Programm einer Gruppe zuweisen – alle Mitglieder erhalten die veröffentlichten Releases.</p>

<div class="panel">
    <div class="panel-title">Zuweisung anlegen</div>
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Programm</label>
            <InputSelect class="form-select" @bind-Value="selectedProgramId">
                <option value="">Programm wählen</option>
                @foreach (var program in programs)
                {
                    <option value="@program.Id">@program.Name</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-5">
            <label class="form-label">Gruppe</label>
            <InputSelect class="form-select" @bind-Value="selectedGroupId">
                <option value="">Gruppe wählen</option>
                @foreach (var group in groups)
                {
                    <option value="@group.Id">@group.Name</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" @onclick="CreateAssignmentAsync">Zuweisen</button>
        </div>
    </div>
</div>

<div class="table-panel">
    <table class="table">
        <thead>
            <tr>
                <th>Programm</th>
                <th>Gruppe</th>
            </tr>
        </thead>
        <tbody>
            @if (assignments.Count == 0)
            {
                <tr>
                    <td colspan="2" class="text-muted">Noch keine Zuweisungen.</td>
                </tr>
            }
            else
            {
                @foreach (var assignment in assignments)
                {
                    <tr>
                        <td>@assignment.Program?.Name</td>
                        <td>@assignment.UserGroup?.Name</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private List<ProgramAssignment> assignments = [];
    private List<UserGroup> groups = [];
    private List<ManagedProgram> programs = [];
    private Guid? selectedGroupId;
    private Guid? selectedProgramId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task CreateAssignmentAsync()
    {
        if (selectedProgramId is null || selectedGroupId is null)
        {
            return;
        }

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var exists = await dbContext.ProgramAssignments.AnyAsync(item =>
            item.ProgramId == selectedProgramId.Value && item.UserGroupId == selectedGroupId.Value);
        if (!exists)
        {
            dbContext.ProgramAssignments.Add(new ProgramAssignment
            {
                ProgramId = selectedProgramId.Value,
                UserGroupId = selectedGroupId.Value
            });
            await dbContext.SaveChangesAsync();
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        programs = await dbContext.Programs.OrderBy(static item => item.Name).ToListAsync();
        groups = await dbContext.UserGroups.OrderBy(static item => item.Name).ToListAsync();
        assignments = await dbContext.ProgramAssignments
            .Include(static item => item.Program)
            .Include(static item => item.UserGroup)
            .OrderBy(item => item.Program!.Name)
            .ToListAsync();
    }
}
