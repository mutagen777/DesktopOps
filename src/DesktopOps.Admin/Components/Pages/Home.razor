@page "/"
@attribute [Authorize(Policy = "Manager")]
@inject IDbContextFactory<DesktopOpsDbContext> DbFactory

<PageTitle>@L["Nav_Overview"]</PageTitle>

<p class="page-lead">@L["Lead_Overview"]</p>

@if (draftReleaseCount > 0 || stagedRolloutCount > 0)
{
    <div class="panel dashboard-status">
        <div class="panel-title">@L["Status"]</div>
        <ul class="mb-0">
            @if (draftReleaseCount > 0)
            {
                <li><a href="releases">@L["DraftReleasesWaiting", draftReleaseCount]</a></li>
            }
            @if (stagedRolloutCount > 0)
            {
                <li><a href="rollouts">@L["StagedRolloutsBelow", stagedRolloutCount]</a></li>
            }
        </ul>
    </div>
}

<div class="dashboard-wrap">
    <div class="dashboard-card">
        <h2 class="dashboard-card-title"><a href="programs">@L["Nav_Programs"]</a></h2>
        <div class="dashboard-card-metric">@programCount</div>
        <div class="dashboard-card-subtitle">@L["Recent"]</div>
        <ul>
            @if (latestPrograms.Count == 0)
            {
                <li class="dashboard-empty">@L["NoneYet"]</li>
            }
            else
            {
                @foreach (var program in latestPrograms)
                {
                    <li><a href="programs">@program.Name</a></li>
                }
            }
        </ul>
    </div>

    <div class="dashboard-card">
        <h2 class="dashboard-card-title"><a href="groups">@L["Nav_Groups"]</a></h2>
        <div class="dashboard-card-metric">@groupCount</div>
        <div class="dashboard-card-subtitle">@L["Recent"]</div>
        <ul>
            @if (latestGroups.Count == 0)
            {
                <li class="dashboard-empty">@L["NoneYet"]</li>
            }
            else
            {
                @foreach (var group in latestGroups)
                {
                    <li><a href="groups">@group.Name</a></li>
                }
            }
        </ul>
    </div>

    <div class="dashboard-card">
        <h2 class="dashboard-card-title"><a href="releases">@L["PublishedReleases"]</a></h2>
        <div class="dashboard-card-metric">@publishedReleaseCount</div>
        <div class="dashboard-card-subtitle">@L["Recent"]</div>
        <ul>
            @if (latestReleases.Count == 0)
            {
                <li class="dashboard-empty">@L["NoneYet"]</li>
            }
            else
            {
                @foreach (var release in latestReleases)
                {
                    <li>
                        <a href="releases">@release.Program?.Name @release.Version</a>
                        @if (release.PublishedAtUtc is null)
                        {
                            <span class="status-draft">@L["Draft"]</span>
                        }
                    </li>
                }
            }
        </ul>
    </div>

    <div class="dashboard-card">
        <h2 class="dashboard-card-title"><a href="assignments">@L["Nav_Assignments"]</a></h2>
        <div class="dashboard-card-metric">@assignmentCount</div>
        <div class="dashboard-card-subtitle">@L["Actions"]</div>
        <ul>
            <li><a href="releases">@L["UploadPublishRelease"]</a></li>
            <li><a href="rollouts">@L["OpenRollouts"]</a></li>
        </ul>
    </div>
</div>

@code {
    private int assignmentCount;
    private int draftReleaseCount;
    private int groupCount;
    private int programCount;
    private int publishedReleaseCount;
    private int stagedRolloutCount;
    private List<ManagedProgram> latestPrograms = [];
    private List<UserGroup> latestGroups = [];
    private List<ReleasePackage> latestReleases = [];

    protected override async Task OnInitializedAsync()
    {
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        programCount = await dbContext.Programs.CountAsync();
        groupCount = await dbContext.UserGroups.CountAsync();
        assignmentCount = await dbContext.ProgramAssignments.CountAsync();
        publishedReleaseCount = await dbContext.ReleasePackages.CountAsync(item => item.PublishedAtUtc != null);
        draftReleaseCount = await dbContext.ReleasePackages.CountAsync(item => item.PublishedAtUtc == null);
        stagedRolloutCount = await dbContext.ReleasePackages.CountAsync(item =>
            item.PublishedAtUtc != null && item.RolloutPercent < 100);

        latestPrograms = await dbContext.Programs
            .OrderBy(static item => item.Name)
            .Take(5)
            .ToListAsync();

        latestGroups = await dbContext.UserGroups
            .OrderBy(static item => item.Name)
            .Take(5)
            .ToListAsync();

        var releases = await dbContext.ReleasePackages
            .Include(static item => item.Program)
            .ToListAsync();
        latestReleases = releases
            .OrderByDescending(static item => item.CreatedAtUtc)
            .Take(5)
            .ToList();
    }
}
