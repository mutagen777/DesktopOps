@page "/programs"
@attribute [Authorize(Policy = "Developer")]
@rendermode InteractiveServer
@inject IDbContextFactory<DesktopOpsDbContext> DbFactory

<PageTitle>@L["Nav_Programs"]</PageTitle>

<p class="page-lead">@L["Lead_Programs"]</p>

<div class="panel">
    <div class="panel-title">@L["CreateProgram"]</div>
    <EditForm Model="model" OnValidSubmit="CreateProgramAsync">
        <div class="form-grid">
            <div>
                <label class="form-label">@L["Name"]</label>
                <InputText class="form-control" @bind-Value="model.Name" />
            </div>
            <div>
                <label class="form-label">@L["Slug"]</label>
                <InputText class="form-control" @bind-Value="model.Slug" />
            </div>
            <div>
                <label class="form-label">@L["ShortName"]</label>
                <InputText class="form-control" @bind-Value="model.ShortName" />
            </div>
            <div>
                <label class="form-label">@L["Description"]</label>
                <InputText class="form-control" @bind-Value="model.Description" />
            </div>
            <div class="form-grid-action">
                <button class="btn btn-primary w-100" type="submit">@L["Add"]</button>
            </div>
        </div>
    </EditForm>
</div>

<div class="table-panel">
    <table class="table">
        <thead>
            <tr>
                <th>@L["Name"]</th>
                <th>@L["Slug"]</th>
                <th>@L["ShortName"]</th>
                <th>@L["Description"]</th>
            </tr>
        </thead>
        <tbody>
            @if (programs.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-muted">@L["NoPrograms"]</td>
                </tr>
            }
            else
            {
                @foreach (var program in programs)
                {
                    <tr>
                        <td>@program.Name</td>
                        <td>@program.Slug</td>
                        <td>@(program.ShortName ?? "—")</td>
                        <td>@(program.Description ?? "—")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private readonly ProgramInput model = new();
    private List<ManagedProgram> programs = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task CreateProgramAsync()
    {
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        dbContext.Programs.Add(new ManagedProgram
        {
            Name = model.Name.Trim(),
            Slug = model.Slug.Trim().ToLowerInvariant(),
            ShortName = string.IsNullOrWhiteSpace(model.ShortName) ? null : model.ShortName.Trim(),
            Description = model.Description?.Trim()
        });

        await dbContext.SaveChangesAsync();
        model.Name = string.Empty;
        model.Slug = string.Empty;
        model.ShortName = string.Empty;
        model.Description = string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        programs = await dbContext.Programs
            .OrderBy(static item => item.Name)
            .ToListAsync();
    }

    private sealed class ProgramInput
    {
        public string Name { get; set; } = string.Empty;

        public string Slug { get; set; } = string.Empty;

        public string ShortName { get; set; } = string.Empty;

        public string? Description { get; set; }
    }
}
