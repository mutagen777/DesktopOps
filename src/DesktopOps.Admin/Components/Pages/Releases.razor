@page "/releases"
@attribute [Authorize(Policy = "Developer")]
@rendermode InteractiveServer
@inject IDbContextFactory<DesktopOpsDbContext> DbFactory
@inject PackageStorageService PackageStorage
@inject PackageSigningOptions SigningOptions

<PageTitle>@L["Nav_Releases"]</PageTitle>

<p class="page-lead">@L["Lead_Releases"]</p>

<div class="panel">
    <div class="panel-title">@L["UploadRelease"]</div>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label">@L["Program"]</label>
            <InputSelect class="form-select" @bind-Value="selectedProgramId">
                <option value="">@L["SelectProgram"]</option>
                @foreach (var program in programs)
                {
                    <option value="@program.Id">@program.Name</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-2">
            <label class="form-label">@L["Version"]</label>
            <InputText class="form-control" @bind-Value="version" />
        </div>
        <div class="col-md-3">
            <label class="form-label">@L["PackageZip"]</label>
            <InputFile OnChange="OnFileSelected" />
        </div>
        <div class="col-md-3">
            <label class="form-label">@L["CmsSignatureOptional"]</label>
            <InputFile OnChange="OnSignatureSelected" accept=".p7s,.sig" />
        </div>
        <div class="col-md-3">
            <label class="form-label">@L["ReleaseNotes"]</label>
            <InputText class="form-control" @bind-Value="releaseNotes" />
        </div>
        <div class="col-md-2">
            <label class="form-label">@L["RolloutPercent"]</label>
            <InputNumber class="form-control" @bind-Value="rolloutPercent" min="0" max="100" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-check-row">
            <InputCheckbox class="form-check-input" @bind-Value="isMandatory" />
            <span>@L["MandatoryUpdate"]</span>
        </label>
    </div>
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-info py-2">@statusMessage</div>
    }
    <button class="btn btn-primary" @onclick="CreateReleaseAsync">@L["Upload"]</button>
</div>

<div class="table-panel">
    <table class="table">
        <thead>
            <tr>
                <th>@L["Program"]</th>
                <th>@L["Version"]</th>
                <th>@L["Sha256"]</th>
                <th>@L["CmsSigned"]</th>
                <th>@L["Delta"]</th>
                <th>@L["Size"]</th>
                <th>@L["Rollout"]</th>
                <th>@L["Status"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (releases.Count == 0)
            {
                <tr>
                    <td colspan="9" class="text-muted">@L["NoReleases"]</td>
                </tr>
            }
            else
            {
                @foreach (var release in releases)
                {
                    <tr>
                        <td>@release.Program?.Name</td>
                        <td>@release.Version</td>
                        <td class="hash-cell">@(string.IsNullOrEmpty(release.PackageHash) ? "—" : release.PackageHash[..Math.Min(12, release.PackageHash.Length)] + "…")</td>
                        <td>@(string.IsNullOrWhiteSpace(release.SignaturePath) ? "—" : L["Yes"])</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(release.DeltaPath))
                            {
                                <span>—</span>
                            }
                            else
                            {
                                <span title="@release.DeltaBaseVersion">@FormatSize(release.DeltaSize ?? 0)</span>
                            }
                        </td>
                        <td>@FormatSize(release.PackageSize)</td>
                        <td>
                            <div class="d-flex gap-1 align-items-center">
                                <input class="form-control form-control-sm"
                                       style="width: 4.5rem;"
                                       type="number"
                                       min="0"
                                       max="100"
                                       value="@GetRolloutEdit(release.Id, release.RolloutPercent)"
                                       @onchange="e => SetRolloutEdit(release.Id, e.Value?.ToString())" />
                                <span>%</span>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => SaveRolloutAsync(release.Id)">OK</button>
                            </div>
                        </td>
                        <td>
                            @if (release.PublishedAtUtc is null)
                            {
                                <span class="status-draft">@L["Draft"]</span>
                            }
                            else
                            {
                                <span class="status-published">@L["Published"]</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (string.IsNullOrWhiteSpace(release.DeltaPath))
                            {
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => GenerateDeltaAsync(release.Id)">@L["GenerateDelta"]</button>
                            }
                            @if (release.PublishedAtUtc is null)
                            {
                                <button class="btn btn-sm btn-primary" @onclick="() => PublishAsync(release.Id)">@L["Publish"]</button>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private readonly Dictionary<Guid, int> rolloutEdits = [];
    private IBrowserFile? packageFile;
    private IBrowserFile? signatureFile;
    private List<ManagedProgram> programs = [];
    private List<ReleasePackage> releases = [];
    private string? releaseNotes;
    private string? statusMessage;
    private Guid? selectedProgramId;
    private bool isMandatory;
    private int rolloutPercent = 100;
    private string version = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        packageFile = args.File;
    }

    private void OnSignatureSelected(InputFileChangeEventArgs args)
    {
        signatureFile = args.File;
    }

    private async Task CreateReleaseAsync()
    {
        statusMessage = null;
        if (selectedProgramId is null || packageFile is null || string.IsNullOrWhiteSpace(version))
        {
            return;
        }

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var program = await dbContext.Programs.FirstAsync(item => item.Id == selectedProgramId.Value);

        await using var stream = packageFile.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024);
        var stored = await PackageStorage.SavePackageAsync(program.Slug, version, packageFile.Name, stream);

        string? signaturePath = null;
        try
        {
            if (signatureFile is not null)
            {
                await using var signatureStream = signatureFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                signaturePath = await PackageStorage.SaveAndVerifyDetachedSignatureAsync(
                    stored.RelativePath,
                    signatureStream,
                    SigningOptions.IsConfigured ? SigningOptions.CertificateThumbprint : null);
            }
            else if (SigningOptions.IsConfigured)
            {
                signaturePath = PackageStorage.SignPackage(stored.RelativePath, SigningOptions.CertificateThumbprint!);
            }
            else if (SigningOptions.RequireSignature)
            {
                PackageStorage.TryDeletePackageArtifacts(stored.RelativePath);
                statusMessage = L["CmsSignatureRequired"];
                return;
            }
        }
        catch (Exception)
        {
            PackageStorage.TryDeletePackageArtifacts(stored.RelativePath);
            statusMessage = L["CmsSignatureFailed"];
            return;
        }

        var release = new ReleasePackage
        {
            ProgramId = program.Id,
            Version = version.Trim(),
            OriginalFileName = packageFile.Name,
            PackagePath = stored.RelativePath,
            PackageHash = stored.Sha256Hash,
            PackageSize = stored.SizeBytes,
            SignaturePath = signaturePath,
            ReleaseNotes = releaseNotes?.Trim(),
            IsMandatory = isMandatory,
            RolloutPercent = Math.Clamp(rolloutPercent, 0, 100)
        };

        var previousPackages = await dbContext.ReleasePackages
            .AsNoTracking()
            .Where(item => item.ProgramId == program.Id)
            .ToListAsync();
        var previous = ReleaseDeltaHelper.FindPreviousRelease(previousPackages, release.Version);
        var deltaAttached = previous is not null && ReleaseDeltaHelper.TryAttachDelta(PackageStorage, release, previous);

        dbContext.ReleasePackages.Add(release);
        await dbContext.SaveChangesAsync();
        packageFile = null;
        signatureFile = null;
        releaseNotes = string.Empty;
        version = string.Empty;
        isMandatory = false;
        rolloutPercent = 100;
        if (deltaAttached)
        {
            statusMessage = string.Format(L["ReleaseUploadedWithDelta"], release.DeltaBaseVersion);
        }
        else
        {
            statusMessage = string.IsNullOrWhiteSpace(signaturePath)
                ? L["ReleaseUploadedUnsigned"]
                : L["ReleaseUploadedSigned"];
        }

        await LoadAsync();
    }

    private async Task GenerateDeltaAsync(Guid releaseId)
    {
        statusMessage = null;
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var release = await dbContext.ReleasePackages.FirstAsync(item => item.Id == releaseId);
        if (!string.IsNullOrWhiteSpace(release.DeltaPath))
        {
            statusMessage = L["DeltaAlreadyPresent"];
            return;
        }

        var previousPackages = await dbContext.ReleasePackages
            .AsNoTracking()
            .Where(item => item.ProgramId == release.ProgramId && item.Id != release.Id)
            .ToListAsync();
        var previous = ReleaseDeltaHelper.FindPreviousRelease(previousPackages, release.Version);
        if (previous is null)
        {
            statusMessage = L["DeltaNoPrevious"];
            return;
        }

        if (!ReleaseDeltaHelper.TryAttachDelta(PackageStorage, release, previous))
        {
            statusMessage = L["DeltaSkipped"];
            return;
        }

        await dbContext.SaveChangesAsync();
        statusMessage = string.Format(L["DeltaGenerated"], release.DeltaBaseVersion);
        await LoadAsync();
    }

    private async Task PublishAsync(Guid releaseId)
    {
        statusMessage = null;
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var release = await dbContext.ReleasePackages.FirstAsync(item => item.Id == releaseId);
        if (SigningOptions.RequireSignature && string.IsNullOrWhiteSpace(release.SignaturePath))
        {
            statusMessage = L["CmsSignatureRequired"];
            return;
        }

        if (rolloutEdits.TryGetValue(releaseId, out var percent))
        {
            release.RolloutPercent = Math.Clamp(percent, 0, 100);
        }

        release.PublishedAtUtc = DateTimeOffset.UtcNow;
        await dbContext.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task SaveRolloutAsync(Guid releaseId)
    {
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var release = await dbContext.ReleasePackages.FirstAsync(item => item.Id == releaseId);
        release.RolloutPercent = Math.Clamp(GetRolloutEdit(releaseId, release.RolloutPercent), 0, 100);
        await dbContext.SaveChangesAsync();
        await LoadAsync();
    }

    private int GetRolloutEdit(Guid releaseId, int stored)
    {
        return rolloutEdits.TryGetValue(releaseId, out var value) ? value : stored;
    }

    private void SetRolloutEdit(Guid releaseId, string? value)
    {
        if (int.TryParse(value, out var parsed))
        {
            rolloutEdits[releaseId] = Math.Clamp(parsed, 0, 100);
        }
    }

    private async Task LoadAsync()
    {
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        programs = await dbContext.Programs.OrderBy(static item => item.Name).ToListAsync();
        var loadedReleases = await dbContext.ReleasePackages
            .Include(static item => item.Program)
            .ToListAsync();
        releases = loadedReleases
            .OrderByDescending(static item => item.CreatedAtUtc)
            .ToList();

        foreach (var release in releases)
        {
            rolloutEdits.TryAdd(release.Id, release.RolloutPercent);
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024.0:0.#} KB";
        }

        return $"{bytes / (1024.0 * 1024.0):0.##} MB";
    }
}
