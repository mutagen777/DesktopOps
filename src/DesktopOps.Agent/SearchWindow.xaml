<Window x:Class="DesktopOps.Agent.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopOps – Updates suchen"
        Width="420"
        Height="160"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusText" Text="Updates werden gesucht…" FontSize="14" Margin="0,0,0,12" />
        <ProgressBar Grid.Row="1" Height="18" IsIndeterminate="True" Margin="0,0,0,12" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Content="Abbrechen" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
