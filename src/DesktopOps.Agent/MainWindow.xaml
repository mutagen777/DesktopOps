<Window x:Class="DesktopOps.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="DesktopOps Agent"
        Height="0"
        Width="0"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden">
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="DesktopOps Agent"
                        MenuActivation="RightClick"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Check for updates" Click="OnCheckUpdatesClick" />
                    <MenuItem Header="Install pending updates" Click="OnInstallClick" />
                    <MenuItem Header="Export diagnostics" Click="OnExportDiagnosticsClick" />
                    <Separator />
                    <MenuItem Header="Exit" Click="OnExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
