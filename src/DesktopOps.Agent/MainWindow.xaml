<Window x:Class="DesktopOps.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="DesktopOps Agent"
        Height="0"
        Width="0"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden">
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="DesktopOps Agent"
                        MenuActivation="RightClick"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Opened="OnContextMenuOpened">
                    <MenuItem x:Name="ConfigurationMenuItem" Click="OnConfigurationClick" />
                    <Separator />
                    <MenuItem x:Name="SearchUpdatesMenuItem" Click="OnSearchUpdatesClick" />
                    <MenuItem x:Name="LastSearchMenuItem" IsEnabled="False" />
                    <MenuItem x:Name="ReinstallMenuItem" Click="OnReinstallClick" />
                    <Separator />
                    <MenuItem x:Name="DiagnosticsMenuItem" Click="OnExportDiagnosticsClick" />
                    <MenuItem x:Name="VersionMenuItem" IsEnabled="False" />
                    <Separator />
                    <MenuItem x:Name="ExitMenuItem" Click="OnExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
