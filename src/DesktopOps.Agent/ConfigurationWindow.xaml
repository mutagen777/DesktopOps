<Window x:Class="DesktopOps.Agent.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopOps – Configuration"
        Width="640"
        Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="520"
        MinHeight="400">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Width="110" Margin="0,0,8,0" IsDefault="True" Click="OnSaveClick" />
            <Button x:Name="CancelButton" Width="110" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>

        <TabControl>
            <TabItem x:Name="GeneralTab">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="InstallFolderLabel" VerticalAlignment="Center" />
                    <TextBox x:Name="InstallDirText" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10" />

                    <TextBlock x:Name="LastSearchLabel" Grid.Row="1" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <Button x:Name="SearchButton" DockPanel.Dock="Right" Width="100" Margin="8,0,0,0" Click="OnSearchClick" />
                        <TextBox x:Name="LastSearchText" IsReadOnly="True" />
                    </DockPanel>

                    <TextBlock x:Name="AgentVersionLabel" Grid.Row="2" VerticalAlignment="Center" />
                    <TextBox x:Name="VersionText" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10" />

                    <CheckBox x:Name="AutoInstallCheck" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,8" />
                    <CheckBox x:Name="NotifyCheck" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,8" />
                </Grid>
            </TabItem>

            <TabItem x:Name="ProgramsTab">
                <DataGrid x:Name="ProgramsGrid"
                          Margin="12"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColName" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn x:Name="ColLatest" Binding="{Binding LatestVersion}" Width="120" />
                        <DataGridTextColumn x:Name="ColInstalled" Binding="{Binding InstalledVersion}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
