<Window x:Class="DesktopOps.Agent.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopOps – Konfiguration"
        Width="640"
        Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="520"
        MinHeight="400">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="110" Margin="0,0,8,0" Content="Speichern" IsDefault="True" Click="OnSaveClick" />
            <Button Width="110" Content="Abbrechen" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>

        <TabControl>
            <TabItem Header="Allgemein">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Installationsordner" VerticalAlignment="Center" />
                    <TextBox x:Name="InstallDirText" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="1" Text="Letzte Suche" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Width="100" Margin="8,0,0,0" Content="Suchen..." Click="OnSearchClick" />
                        <TextBox x:Name="LastSearchText" IsReadOnly="True" />
                    </DockPanel>

                    <TextBlock Grid.Row="2" Text="Agent-Version" VerticalAlignment="Center" />
                    <TextBox x:Name="VersionText" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10" />

                    <CheckBox x:Name="AutoInstallCheck" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,8"
                              Content="Updates beim Start automatisch installieren" />
                    <CheckBox x:Name="NotifyCheck" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,8"
                              Content="Benachrichtigen, wenn Updates gefunden wurden" />
                </Grid>
            </TabItem>

            <TabItem Header="Programme">
                <DataGrid x:Name="ProgramsGrid"
                          Margin="12"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Neueste Version" Binding="{Binding LatestVersion}" Width="120" />
                        <DataGridTextColumn Header="Installierte Version" Binding="{Binding InstalledVersion}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
