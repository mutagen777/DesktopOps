{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DesktopOps": "Server=sql.example.local;Database=DesktopOps;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Storage": {
    "RootPath": "D:\\DesktopOps\\storage"
  },
  "Security": {
    "ApiKey": "",
    "AdminApiKey": "",
    "ApiKeyHeader": "X-DesktopOps-Key"
  },
  "Signing": {
    "CertificateThumbprint": "",
    "RequireSignature": true
  },
  "AllowedHosts": "desktopops.example.local"
}
